{% include "partials/head.njk" %}

{% include "partials/menu.njk" %}

<main class="page">

  <article class="group-detail base__margin">

    <header class="group-detail__hero">

      <p class="group-detail__label">
        Skupinové koučování
      </p>

      <h1 class="group-detail__title">
        {{ title }}
      </h1>

      <div class="group-detail__intro">

        <p>
          Práce. Rodina. Domácnost. Lidé, na kterých vám záleží.
          Věci, které je potřeba zařídit.
        </p>

        <p>
          A někde mezi tím vším jste vy.
        </p>

        <p class="group-detail__intro-highlight">
          Jenže až bude všechno hotovo, pravděpodobně nepřijde nikdy.
        </p>

      </div>


      <div class="group-detail__meta">

        {% if city %}
          <span>{{ city }}</span>
        {% endif %}

        {% if event_date %}
          <span>{{ event_date }}</span>
        {% endif %}

        {% if time %}
          <span>{{ time }}</span>
        {% endif %}

        {% if place %}
          <span>{{ place }}</span>
        {% endif %}

        {% if capacity %}
          <span>Kapacita: {{ capacity }}</span>
        {% endif %}

      </div>


      {% if status == "interest" %}

        <div class="group-detail__cta group-interest">

          <p class="group-detail__cta-text">
            {{ interest_text }}
          </p>

          <form
            name="zajem-skupinove-koucovani"
            method="POST"
            data-netlify="true"
            action="/dekuji-za-zajem/"
            class="group-interest__form">

            <input
              type="hidden"
              name="form-name"
              value="zajem-skupinove-koucovani">

            <input
              type="hidden"
              name="program"
              value="{{ title }}">

            <div class="group-interest__field">

              <label for="interest-email">
                E-mail
              </label>

              <input
                type="email"
                id="interest-email"
                name="email"
                autocomplete="email"
                required>

            </div>

            <label class="group-interest__consent">

              <input
                type="checkbox"
                name="gdpr-souhlas"
                value="ano"
                required>

              <span>
                Souhlasím se zpracováním své e-mailové adresy
                za účelem zaslání informace o otevření registrace
                na toto skupinové koučování.
                <a href="/gdpr/" target="_blank" rel="noopener">
                  Více o zpracování osobních údajů
                </a>.
              </span>

            </label>

            <button
              type="submit"
              class="button button--primary">
              Dejte mi vědět, až bude termín
            </button>

          </form>

        </div>


      {% elif status == "open" %}

        <div class="group-detail__cta">

          <p class="group-detail__cta-text">
            Registrace je otevřená.
          </p>

          {% if price %}
            <p class="group-detail__price">
              {{ price }}
            </p>
          {% endif %}

          <a
            href="#registrace"
            class="button button--primary">
            Chci se přihlásit
          </a>

        </div>


      {% elif status == "closed" %}

        <div class="group-detail__cta">

          <p class="group-detail__cta-text">
            Tento termín je právě uzavřený.
          </p>

        </div>

      {% endif %}

    </header>


    <div class="group-detail__content">
      {{ content | safe }}
    </div>


    <section class="group-detail__practical">

      <p class="group-offer__label">
        Praktické informace
      </p>

      <h2>
        Kdy a kde
      </h2>

      <dl class="group-detail__practical-list">

        {% if event_date %}
          <div>
            <dt>Datum</dt>
            <dd>{{ event_date }}</dd>
          </div>
        {% endif %}

        {% if time %}
          <div>
            <dt>Čas</dt>
            <dd>{{ time }}</dd>
          </div>
        {% endif %}

        {% if place %}
          <div>
            <dt>Místo</dt>
            <dd>
              {{ place }}

              {% if address %}
                <br>
                {{ address }}
              {% endif %}
            </dd>
          </div>

        {% elseif city %}
          <div>
            <dt>Místo</dt>
            <dd>{{ city }}</dd>
          </div>
        {% endif %}

        {% if capacity %}
          <div>
            <dt>Kapacita</dt>
            <dd>{{ capacity }}</dd>
          </div>
        {% endif %}

        {% if price %}
          <div>
            <dt>Cena</dt>
            <dd>{{ price }}</dd>
          </div>
        {% endif %}

      </dl>

      <p class="group-detail__minimum">
        Setkání proběhne při minimálním počtu 4 účastníků.
      </p>

    </section>


    {% if status == "open" %}

      <section class="group-registration" id="registrace">

        <p class="group-offer__label">
          Registrace
        </p>

        <h2>
          Chci se přihlásit
        </h2>

        <p>
          Odesláním formuláře se závazně registrujete na skupinové koučování
          <strong>{{ title }}</strong>.
        </p>

        <p>
          Místo je potvrzené po uhrazení ceny
          <strong>{{ price }}</strong> do 5 pracovních dnů od registrace.
          Pokud platba nepřijde, po připomenutí může registrace zaniknout.
        </p>


        <div class="group-registration__conditions">

          <h3>
            Storno podmínky
          </h3>

          <ul>

            <li>
              Při zrušení více než 7 dní před setkáním
              vám vrátím celou uhrazenou částku.
            </li>

            <li>
              Při zrušení méně než 7 dní před setkáním
              je částka nevratná,
              ale své místo můžete převést na jiného člověka.
            </li>

            <li>
              Pokud setkání zruším já
              nebo se nenaplní minimální počet 4 účastníků,
              vrátím vám celou uhrazenou částku.
            </li>

          </ul>

        </div>


        <form
          name="registrace-skupinove-koucovani"
          method="POST"
          data-netlify="true"
          action="/dekuji-za-registraci/"
          class="group-registration__form">

          <input
            type="hidden"
            name="form-name"
            value="registrace-skupinove-koucovani">

          <input
            type="hidden"
            name="program"
            value="{{ title }}">

          <input
            type="hidden"
            name="termin"
            value="{{ event_date }} {{ time }}">


          <div class="group-registration__field">

            <label for="registration-name">
              Jméno a příjmení
            </label>

            <input
              type="text"
              id="registration-name"
              name="jmeno"
              autocomplete="name"
              required>

          </div>


          <div class="group-registration__field">

            <label for="registration-email">
              E-mail
            </label>

            <input
              type="email"
              id="registration-email"
              name="email"
              autocomplete="email"
              required>

          </div>


          <div class="group-registration__field">

            <label for="registration-phone">
              Telefon
            </label>

            <input
              type="tel"
              id="registration-phone"
              name="telefon"
              autocomplete="tel"
              required>

          </div>


          <div class="group-registration__field">

            <label for="registration-expectation">
              Co byste si ze setkání chtěli odnést?
            </label>

            <p class="group-registration__hint">
              Stačí pár slov.
            </p>

            <textarea
              id="registration-expectation"
              name="ocekavani"
              rows="5"></textarea>

          </div>


          <details class="group-registration__invoice">

            <summary>
              Potřebuji vystavit fakturu
            </summary>

            <p class="group-registration__hint">
              Následující údaje vyplňte pouze tehdy,
              pokud fakturu potřebujete.
            </p>

            <div class="group-registration__field">

              <label for="invoice-name">
                Jméno / název odběratele
              </label>

              <input
                type="text"
                id="invoice-name"
                name="fakturacni_jmeno">

            </div>


            <div class="group-registration__field">

              <label for="invoice-address">
                Fakturační adresa
              </label>

              <input
                type="text"
                id="invoice-address"
                name="fakturacni_adresa"
                autocomplete="street-address">

            </div>


            <div class="group-registration__field">

              <label for="invoice-ico">
                IČO, pokud se vás týká
              </label>

              <input
                type="text"
                id="invoice-ico"
                name="ico">

            </div>

          </details>


          <label class="group-registration__consent">

            <input
              type="checkbox"
              name="souhlas-podminky"
              value="ano"
              required>

            <span>
              Souhlasím s uvedenými podmínkami registrace
              a storno podmínkami.
            </span>

          </label>


          <label class="group-registration__consent">

            <input
              type="checkbox"
              name="gdpr-potvrzeni"
              value="ano"
              required>

            <span>
              Beru na vědomí zpracování osobních údajů
              pro účely registrace, organizace setkání a související komunikace.
              <a href="/gdpr/" target="_blank" rel="noopener">
                Více o zpracování osobních údajů
              </a>.
            </span>

          </label>


          <button
            type="submit"
            class="button button--primary">
            Závazně se přihlásit
          </button>

        </form>

      </section>

    {% endif %}


    <section class="group-detail__closing">

      <p>
        Práce možná hotová nebude.
      </p>

      <p>
        Domácnost pravděpodobně také ne.
      </p>

      <p>
        A další věci budou přibývat.
      </p>

      <p class="group-detail__closing-question">
        <strong>
          Otázka tedy není, kdy bude konečně všechno hotovo.
          Otázka je: Kdy budete vy?
        </strong>
      </p>


      {% if status == "open" %}

        <a
          href="#registrace"
          class="button button--primary">
          Chci se přihlásit
        </a>

      {% endif %}

    </section>

  </article>

</main>

{% include "partials/footer.njk" %}

</html>